// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERUSER
  ADMIN
  UMUM
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(UMUM)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  schedules Schedule[]
  notes     Note[]
  databases Database[]
  history   History[]

  @@map("users")
}

model Schedule {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  location    String?
  status      String   @default("planned")
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("schedules")
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  color     String?
  favorite  Boolean  @default(false)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}

model Database {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  icon        String?
  columns     Json     // Array of {key, label, type}
  rows        Json     // Array of {id, properties}
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("databases")
}

enum HistoryAction {
  CREATE
  EDIT
  DELETE
}

enum HistoryTarget {
  NOTE
  DATABASE
  SCHEDULE
}

model History {
  id          Int            @id @default(autoincrement())
  userId      Int
  userName    String
  userRole    Role
  action      HistoryAction
  target      HistoryTarget
  targetName  String?
  description String
  createdAt   DateTime       @default(now())

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("history")
  @@index([createdAt(sort: Desc)])
}
